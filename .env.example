# Pago con tarjeta: "dlocalgo" (real) o "mock" (pruebas, sin cobro). Vacío = solo transferencia
# (los datos bancarios se escriben en /admin/ajustes) o pedidos por WhatsApp.
PAYMENT_PROVIDER=mock

# URL pública del sitio (para las URLs de retorno del pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# dLocal Go (https://dashboard.dlocalgo.com) — solo si PAYMENT_PROVIDER=dlocalgo.
# En el panel de dLocal Go, la URL de notificaciones es NEXT_PUBLIC_SITE_URL + /api/webhooks/dlocalgo
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
DLOCALGO_SANDBOX=true

# Base de datos Postgres (Neon, Supabase, Vercel Postgres…). Obligatoria en producción.
# Sin ella, en desarrollo se usa un Postgres embebido guardado en .data/pglite.
DATABASE_URL=

# Correos (https://resend.com). Sin RESEND_API_KEY los correos se imprimen en consola.
RESEND_API_KEY=
EMAIL_FROM="Helix Research <pedidos@tudominio.cl>"
ORDERS_NOTIFY_EMAIL=

# Clave del panel de administración (/admin)
ADMIN_PASSWORD=

# Fotos de productos subidas desde /admin (Vercel: Storage > Create Database > Blob lo agrega solo)
BLOB_READ_WRITE_TOKEN=

# Direcciones en el checkout: por defecto usa Photon (OpenStreetMap, gratis). "mock" devuelve resultados fijos para pruebas.
GEO_PROVIDER=
